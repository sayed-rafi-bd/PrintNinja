            "server_revision": 1,
            "html": "<p>local edit</p>"
          }
        ],
        "gone": [],
        "sync_cursor": "Mw==",
        "report": {
          "applied_upserts": 0,
          "applied_deletes": 0,
          "skipped_dirty": 1
        }
      }
    },
    {
      "name": "a dirty row survives its remote delete",
      "given": {
        "templates": [
