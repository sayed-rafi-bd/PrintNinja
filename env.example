# PrintNinja environment variables (working defaults).
#
# There is exactly one live env file: server/.env (next to
# server/docker-compose.yml and server/env.example). Compose reads it on
# its own; local server runs use `node --env-file=.env` from server/.
# There is intentionally no root .env: Vite needs no variables, and dev
# scripts default BASE_URL when unset. Never commit any `.env` file.
#
# Every variable, explained: docs/ENV.md.

# Dev web app address (scripts/capture-screens.mjs). Only needed to
# override the http://localhost:1420 default, in a root .env you
# create yourself.

# Dev web app address (scripts/capture-screens.mjs). Only needed to
# override the http://localhost:1420 default, in a root .env you
# create yourself.
BASE_URL=http://localhost:1420

# Comma-separated exact-match allow-list, no wildcards.
# Production desktop app: tauri://localhost. Dev app: http://localhost:1420.
CORS_ORIGINS="http://localhost:1420,tauri://localhost,http://tauri.localhost"

HOST=127.0.0.1
PORT=3001
# SERVER_PORT=3001
TRUST_PROXY=0

# Turso Cloud (libsql:// + token) or a local file. No token for file:.
# DATABASE_URL=file:./dev.db
# DATABASE_AUTH_TOKEN=

SESSION_TTL_DAYS=30
SESSION_CLEANUP_MINUTES=60
SYNC_TOMBSTONE_DAYS=90
SYNC_PAGE_BYTES=8388608

RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300

ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

DOCS_ENABLED=true
LOG_LEVEL=info
