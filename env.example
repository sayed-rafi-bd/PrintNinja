# PrintNinja environment variables (only ones the code actually reads).
#
# Nothing loads this file automatically: neither the share service nor the
# scripts use a dotenv loader. Copy it to `.env` and load it yourself, e.g.
#   set -a; . ./.env; set +a; cargo run --manifest-path server-legacy/Cargo.toml
# Never commit `.env`.

# ---- Share service (server-legacy/) ------------------------------------------

# SQLite file the share service stores accounts, sessions and published
# templates in. Default: printninja-server.db in the working directory.
DATABASE_URL=printninja-server.db

# Port the share service listens on (binds 0.0.0.0). Default: 3001.
PORT=3001

# Log filter. The server adds `printninja-server=info` by default; use this to
# turn up detail, e.g. `debug` or `printninja-server=debug,tower_http=debug`.
RUST_LOG=info

# ---- Dev scripts -------------------------------------------------------------

# Address of the running dev server, used by scripts/capture-screens.mjs.
# Default: http://localhost:1420 (the `pnpm dev` port).
BASE_URL=http://localhost:1420

# ---- Docker (server-legacy/docker-compose.yml) -------------------------------
# Compose reads this file when it is named `.env` and sits next to the compose
# file (server-legacy/.env; unlike the server itself, which loads nothing).
# DATABASE_URL and PORT are fixed inside the image (/data/printninja-server.db
# and 3001); only RUST_LOG above is passed through.

# ---- v2 service (server/) and root docker-compose.yml ------------------------
# The service loads nothing automatically: development runs pass --env-file
# (e.g. node --env-file=.env), compose passes the values below.
# NOTE: DATABASE_URL collides with the legacy variable above on purpose —
# only one service runs at a time. The v2 service wants a PostgreSQL URL;
# values from the legacy block (a SQLite path, RUST_LOG) are ignored by it.

# PostgreSQL URL for local runs (docker-compose sets its own inside the
# stack). Default for scratch work: the container below on port 5433.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/printninja

# Password for the compose PostgreSQL (alphanumeric; it is interpolated
# into DATABASE_URL inside docker-compose.yml). No default: compose
# refuses to start without it.
# POSTGRES_PASSWORD=change-me

# Comma-separated origins allowed to call the API. The Tauri window and
# the Vite dev server must both be listed (space after the comma is fine).
CORS_ORIGINS=http://localhost:1420, tauri://localhost, http://tauri.localhost

# Bind address and port. Compose overrides HOST to 0.0.0.0; keep 127.0.0.1
# for local runs so the service never listens beyond the machine.
HOST=127.0.0.1
PORT=3001

# Host port published by compose. Default: 3001.
# SERVER_PORT=3001

# Reverse-proxy hops to trust for the client IP (0 = none, direct clients;
# any positive value means one proxy on this host — see src/app.ts).
TRUST_PROXY=0

# Session lifetime in days; expired sessions are purged at startup and
# every SESSION_CLEANUP_MINUTES minutes (no job queue).
SESSION_TTL_DAYS=30
SESSION_CLEANUP_MINUTES=60

# Days tombstones are kept before the hourly cleanup purges them (a
# cursor older than the oldest kept tombstone answers reset: true).
SYNC_TOMBSTONE_DAYS=90

# Per-page byte budget for GET /v2/sync/changes (pages also stop at the
# record limit). One template can be 832 KiB, so the budget usually
# matters more than the count.
SYNC_PAGE_BYTES=8388608

# Global rate limit: RATE_LIMIT_MAX requests per minute per IP. Auth
# routes (register, login) tighten to RATE_LIMIT_AUTH_MAX attempts per
# RATE_LIMIT_AUTH_WINDOW_SECONDS seconds per IP and handle.
RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300

# Argon2id cost for new password hashes (OWASP baseline). Lower only in
# throwaway test environments, never in production.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Serve /docs and /openapi.json. Default: true.
DOCS_ENABLED=true

# pino log level for the v2 service: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info
