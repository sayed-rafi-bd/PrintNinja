# PrintNinja environment variables (working defaults).
#
# Nothing loads this file automatically. Where each consumer reads from:
# - docker compose: copy the database + CORS lines into server/.env
#   (compose reads server/.env on its own).
# - local server runs: node --env-file=.env (from server/).
# - dev scripts: shell `set -a; . ./.env; set +a` from the repo root.
# Never commit any `.env` file.
#
# Every variable, explained: docs/ENV.md.

# Dev web app address (scripts/capture-screens.mjs).
BASE_URL=http://localhost:1420

# Compose PostgreSQL password. Required, no default.
# Letters and digits only (it is interpolated into DATABASE_URL).
# Generate a real one for anything shared: openssl rand -hex 24
# POSTGRES_PASSWORD=

# Server database URL for non-compose runs (compose sets its own).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/printninja

# Comma-separated exact-match allow-list, no wildcards.
# Production desktop app: tauri://localhost. Dev app: http://localhost:1420.
CORS_ORIGINS="http://localhost:1420,tauri://localhost,http://tauri.localhost"

HOST=127.0.0.1
PORT=3001
# SERVER_PORT=3001
TRUST_PROXY=0

SESSION_TTL_DAYS=30
SESSION_CLEANUP_MINUTES=60
SYNC_TOMBSTONE_DAYS=90
SYNC_PAGE_BYTES=8388608

RATE_LIMIT_MAX=120
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300

ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

DOCS_ENABLED=true
LOG_LEVEL=info
