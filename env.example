# PrintNinja environment variables
#
# This file lists only the variables the code actually reads.
#
# HOW TO USE
# 1. Copy this file to .env
# 2. Edit the values you need.
# 3. Load it yourself. Nothing loads it automatically.
#    Shell:   set -a; . ./.env; set +a
#    Node:    node --env-file=.env
#    Compose: run from server/ — docker compose reads server/.env by itself.
# 4. Never commit .env to git.
#
# HOW TO READ THIS FILE
# Each setting has a short description, then optional Default and Required
# lines, then the setting itself.
# A setting that starts with a hash sign is commented out. Remove the hash
# sign to turn it on.
# Sections are numbered: SECTION 1 of 8 up to SECTION 8 of 8.


# SECTION 1 of 8: Dev scripts

# BASE_URL
# Address of the running dev server. Used by scripts/capture-screens.mjs.
# Default: http://localhost:1420 (the port used by pnpm dev).
BASE_URL=http://localhost:1420


# SECTION 2 of 8: Database

# POSTGRES_PASSWORD
# Password for the PostgreSQL container in docker-compose.yml.
# Required for Docker Compose. It has no default, and compose refuses to
# start without it.
# Use letters and digits only. The password is placed inside DATABASE_URL,
# so characters such as @ : / # % would break the URL.
# To generate one: openssl rand -hex 24
# POSTGRES_PASSWORD=

# DATABASE_URL
# PostgreSQL connection URL for running the server outside Docker.
# Not needed with Docker Compose, which sets its own value.
# Example for scratch work: a local container on port 5433.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/printninja


# SECTION 3 of 8: Network

# CORS_ORIGINS
# Origins allowed to call the API, separated by commas.
# The Tauri window and the Vite dev server must both be listed.
# The value is in quotes so that the shell can load this file safely.
# Default: http://localhost:1420
CORS_ORIGINS="http://localhost:1420,tauri://localhost,http://tauri.localhost"

# HOST
# Address the server listens on.
# Keep 127.0.0.1 for local runs so the server is not reachable from other
# machines. Docker Compose overrides this to 0.0.0.0 on its own.
HOST=127.0.0.1

# PORT
# Port the server listens on.
PORT=3001

# SERVER_PORT
# Port on your machine that Docker Compose publishes.
# Default: 3001
# SERVER_PORT=3001

# TRUST_PROXY
# Number of reverse proxy hops to trust when finding the client IP address.
# 0 means no proxy, clients connect directly.
# Any positive number means one proxy on this host. See src/app.ts.
TRUST_PROXY=0


# SECTION 4 of 8: Sessions

# SESSION_TTL_DAYS
# How many days a session lasts.
SESSION_TTL_DAYS=30

# SESSION_CLEANUP_MINUTES
# How often, in minutes, expired sessions are deleted.
# They are also deleted once at startup. There is no job queue.
SESSION_CLEANUP_MINUTES=60


# SECTION 5 of 8: Sync

# SYNC_TOMBSTONE_DAYS
# How many days deleted-record markers (tombstones) are kept.
# The hourly cleanup removes older ones.
# A sync cursor older than the oldest kept tombstone gets reset: true.
SYNC_TOMBSTONE_DAYS=90

# SYNC_PAGE_BYTES
# Size limit in bytes for one page of GET /v2/sync/changes.
# A page also stops at the record limit.
# One template can be 832 KiB, so this byte limit usually matters more
# than the record count.
# 8388608 bytes is 8 MiB.
SYNC_PAGE_BYTES=8388608


# SECTION 6 of 8: Rate limits

# RATE_LIMIT_MAX
# Global limit: requests per minute for each IP address.
RATE_LIMIT_MAX=120

# RATE_LIMIT_AUTH_MAX
# Stricter limit for register and login: number of attempts allowed for each
# IP address and handle within the window below.
RATE_LIMIT_AUTH_MAX=10

# RATE_LIMIT_AUTH_WINDOW_SECONDS
# Length in seconds of the window for RATE_LIMIT_AUTH_MAX.
# 300 seconds is 5 minutes.
RATE_LIMIT_AUTH_WINDOW_SECONDS=300


# SECTION 7 of 8: Password hashing (Argon2id)

# These are the OWASP baseline settings for new password hashes.
# Lower them only in throwaway test environments. Never in production.

# ARGON2_MEMORY_KIB
# Memory cost in KiB. 19456 KiB is about 19 MiB.
ARGON2_MEMORY_KIB=19456

# ARGON2_TIME_COST
# Number of passes.
ARGON2_TIME_COST=2

# ARGON2_PARALLELISM
# Number of parallel threads.
ARGON2_PARALLELISM=1


# SECTION 8 of 8: Docs and logging

# DOCS_ENABLED
# Serve the /docs and /openapi.json pages.
# Values: true or false.
# Default: true. Consider false in production.
DOCS_ENABLED=true

# LOG_LEVEL
# Log level of the v2 service (pino).
# Values, from most to least detailed: trace, debug, info, warn, error, fatal.
# Default: info
LOG_LEVEL=info
