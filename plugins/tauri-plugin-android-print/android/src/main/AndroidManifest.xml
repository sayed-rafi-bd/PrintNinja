<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Foreground service keeping the print queue alive. POST_NOTIFICATIONS
         covers the persistent notification on Android 13+. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Merged into the app manifest by the Gradle manifest merger.
             exported=false: only the app's own notification starts it. -->
        <service
            android:name="com.printninja.android_print.PrintNinjaService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
