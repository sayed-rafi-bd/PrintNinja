{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": { "enabled": false },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**/*.{ts,tsx}",
      "index.html",
      "vite.config.ts",
      "server/src/**/*.ts",
      "server/test/**/*.ts",
      "e2e/**/*.ts",
      "!server/src/infra/prisma/generated/**",
      "!server/dist/**",
      "!src/lib/api/schema.d.ts"
    ]
  },
  "formatter": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "noUnusedImports": "off"
      }
    }
  },
  "assist": {
    "enabled": false,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "javascript": {
    "formatter": { "enabled": false }
  }
}
