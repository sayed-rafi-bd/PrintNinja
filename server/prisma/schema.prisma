// Phase 1 slice of REFACTORING.md section 7: identity, sessions and the
// change-tracking tables. Phase 2 adds the library models below, each
// slice with its own migration.
generator client {
  provider = "prisma-client-js"
  output   = "../src/infra/db/generated"
}

// Prisma 7: no url here. The connection string lives in prisma.config.ts.
// SQLite-family provider: local files for development and tests, Turso
// (libsql://) in production via the @prisma/adapter-libsql driver adapter.
datasource db {
  provider = "sqlite"
}

model User {
  // Prisma 7 fills uuid() in the client, so the migration carries no
  // database default; our flows always supply the id anyway.
  id           String    @id @default(uuid())
  handle       String // as typed, 1 to 32 of A-Z a-z 0-9 _ -
  handleKey    String    @unique @map("handle_key") // lowercase of handle; case-insensitive uniqueness
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]
  templates    Template[]
  saved        SavedTemplate[]
  datasets     SampleDataset[]
  profiles     PrinterProfile[]
  settings     UserSetting[]
  fonts        Font[]
  sync         UserSync?
  tombstones   Tombstone[]
  useDaily     TemplateUseDaily[]

  @@map("users")
}

model Session {
  tokenHash String   @id @map("token_hash") // SHA-256 hex of the opaque token
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Change tracking (Phase 1 creates this and Tombstone; Phase 2 uses them).
// Every synced write locks this row and increments nextSeq in the same
// transaction, so one user's change numbers commit in order with no gaps.
model UserSync {
  userId  String @id @map("user_id")
  nextSeq BigInt @default(1) @map("next_seq")
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sync")
}

model Tombstone {
  userId    String   @map("user_id")
  seq       BigInt
  entity    String // template | dataset | profile | setting | font
  entityKey String   @map("entity_key") // the UUID, or the setting key
  deletedAt DateTime @default(now()) @map("deleted_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, seq])
  @@index([userId, deletedAt])
  @@map("tombstones")
}

// Phase 4, deliverable 1: account-owned library records (section 8).
// Every row carries the owner's change sequence so the delta sync can
// merge it; deletes leave tombstones with the matching entity name.
model SampleDataset {
  id        String   @id // client-generated, like templates (offline create)
  ownerId   String   @map("owner_id")
  name      String
  dataJson  String   @default("{}") @map("data_json") // sample data JSON, 256 KiB cap checked in the domain
  revision  Int      @default(1) // +1 on every content change; checked on update
  changeSeq BigInt   @map("change_seq")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, changeSeq])
  @@map("sample_datasets")
}

model PrinterProfile {
  id          String   @id // client-generated, like templates (offline create)
  ownerId     String   @map("owner_id")
  templateId  String   @map("template_id")
  printerName String   @map("printer_name") // lowercased on write (question 20)
  settingsJson String  @default("{}") @map("settings_json")
  revision    Int      @default(1)
  changeSeq   BigInt   @map("change_seq")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([ownerId, templateId, printerName])
  @@index([ownerId, changeSeq])
  @@map("printer_profiles")
}

model UserSetting {
  userId    String   @map("user_id")
  key       String
  value     String  
  revision  Int      @default(1)
  changeSeq BigInt   @map("change_seq")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
  @@index([userId, changeSeq])
  @@map("user_settings")
}

model Font {
  id          String   @id // client-generated, like templates (offline create)
  ownerId     String   @map("owner_id")
  name        String
  format      String   @default("") // ttf | otf | woff2, checked against magic bytes; empty until the file lands
  sizeBytes   Int      @default(0) @map("size_bytes")
  sha256      String   @default("") // of the stored bytes; the download ETag
  revision    Int      @default(1)
  changeSeq   BigInt   @map("change_seq")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  file        FontFile?

  @@index([ownerId, changeSeq])
  @@map("fonts")
}

model FontFile {
  fontId    String   @id @map("font_id")
  bytes     Bytes
  updatedAt DateTime @updatedAt @map("updated_at")
  font      Font     @relation(fields: [fontId], references: [id], onDelete: Cascade)

  @@map("font_files")
}

// Phase 2, deliverable 1: the template library (section 7). Datasets,
model Template {
  id          String          @id // client-generated, kept from v1
  ownerId     String          @map("owner_id")
  name        String
  summary     String          @default("")
  pageWMm     Float           @map("page_w_mm")
  pageHMm     Float           @map("page_h_mm")
  language    String          @default("html")
  body        String // HTML; 512 KiB cap checked in the domain
  css         String          @default("") // 256 KiB cap
  readme      String          @default("") // 64 KiB cap
  useCount    Int             @default(0) @map("use_count")
  revision    Int             @default(1) // +1 on every content change; checked on update
  changeSeq   BigInt          @map("change_seq") // owner's sequence number at the last change
  publishedAt DateTime?       @map("published_at") // null means private
  firstPublishedAt DateTime?  @map("first_published_at") // set once; unpublish never clears it, so republishing keeps the original time
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  owner       User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  versions    TemplateVersion[]

  @@index([ownerId, changeSeq])
  @@index([ownerId, updatedAt])
  @@index([publishedAt, updatedAt])
  @@map("templates")
}

model SavedTemplate {
  userId     String   @map("user_id")
  templateId String   @map("template_id")
  addedAt    DateTime @default(now()) @map("added_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // No relation to Template on purpose (plan section 7 shows one with
  // onDelete: Cascade, which E14 overrules): saved rows must survive a
  // template delete so the manifest can report them as deleted. The
  // templateId is deliberately a bare UUID; joins are manual.
  @@id([userId, templateId])
  @@index([templateId])
  @@map("saved_templates")
}

// Per-user, per-template, per-day print counters behind the use-count
// abuse cap: one account can add at most MAX_USE_PER_USER_TEMPLATE_PER_DAY
// counts to one template per UTC day, so gaming the community "used"
// sort needs a fresh account every day. Bare templateId like SavedTemplate:
// use rows must survive a template delete (the cap still applies on 404s,
// and the rows are tiny).
model TemplateUseDaily {
  userId     String   @map("user_id")
  templateId String   @map("template_id")
  day        DateTime @map("day")
  count      Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, templateId, day])
  @@map("template_use_daily")
}

// Every content-changing PUT appends one row (Phase 2, deliverable 4).
model TemplateVersion {
  id         String        @id @default(uuid())
  templateId String        @map("template_id")
  versionNo  Int           @map("version_no")
  body       String
  css        String        @default("")
  label      String?
  note       String?
  createdBy  VersionSource @map("created_by")
  createdAt  DateTime      @default(now()) @map("created_at")
  template   Template      @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, versionNo])
  @@map("template_versions")
}

// Matches the app's CHECK constraint. `sync` is gone: pulling a server copy no longer
// writes a version, because versions now live on the server (this removes the cause of P2).
enum VersionSource {
  manual
  autosave
  restore
}
