                      ]
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status",
                    "version"
                  ],
                  "additionalProperties": false,
                  "description": "Liveness and version of the service."
                }
              }
            }
          }
        }
      }
    },
