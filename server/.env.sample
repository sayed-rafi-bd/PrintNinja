# PrintNinja local stack — usable defaults for `server/docker-compose.yml`.
# Copy to `.env` in this folder and go:
#   cp .env.sample .env && docker compose up -d --build
# Never commit `.env`. Full reference for every variable: ../env.example.

# PostgreSQL password. Dev-only value below; generate a real one for
# anything shared: openssl rand -hex 24
# Use letters and digits only — it is interpolated into DATABASE_URL,
# so characters such as @ : / # % would break the URL.
POSTGRES_PASSWORD=changeme01

# Origins allowed to call the API (exact match, comma-separated, no wildcard).
# Production desktop app: tauri://localhost. Dev app: http://localhost:1420.
# Trim to tauri://localhost (plus http://tauri.localhost for Android) on a
# production host; a missing origin makes the browser block the response.
CORS_ORIGINS=http://localhost:1420, tauri://localhost, http://tauri.localhost

# Host port published for the API. Default: 3001.
# SERVER_PORT=3001
