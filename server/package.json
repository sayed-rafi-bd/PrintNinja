{
  "name": "server",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && cp src/infra/prisma/generated/package.json dist/infra/prisma/generated/package.json",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise --config .dependency-cruiser.mjs src",
    "test": "vitest run",
    "test:unit": "vitest run --exclude test/integration",
    "test:int": "vitest run test/integration",
    "test:e2e": "vitest run --config vitest.e2e.config.mts",
    "openapi:generate": "tsx scripts/openapi-generate.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/client-runtime-utils": "7.10.1",
    "argon2": "0.45.1",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@seriousme/openapi-schema-validator": "2.11.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.7.0",
    "dotenv": "^18.0.8",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "~5.6.2",
    "vitest": "5.0.5"
  }
}
