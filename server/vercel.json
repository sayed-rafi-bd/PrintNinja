{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  // Deploy this directory (`server/`) as its own Vercel project
  // (Root Directory = server). The API is one Node.js function.
  // the web app is a separate project.
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      // Belt and braces: the bundled Prisma query compiler reads its
      // .wasm next to the generated client. Harmless if tracing
      // already picks the files up.
      "includeFiles": "src/infra/db/generated/**"
    }
  },
  // Local runs keep working: the function entry (api/index.ts) shares
  // the stack in src/boot.ts with the long-lived entry (src/server.ts).
  "buildCommand": "pnpm db:generate && pnpm build"
}
