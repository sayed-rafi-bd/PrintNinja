# PrintNinja server environment: the one template for `server/.env`.
# Copy to `.env` in this folder:
#   cp env.example .env
# Docker:        docker compose up -d --build
# Local server:  pnpm dev   (also pnpm db:apply, db:generate, db:migrate)
# Never commit `.env`. Every variable, explained: ../docs/ENV.md.
# Commented lines show the built-in default; uncomment only to override.

# Database. Leave commented for `docker compose up` (the compose file
# defaults to a file in the named volume, zero configuration).
# Local runs need it set, and copying this file does not set it: remove
# the leading `# ` from ONE line. `pnpm dev`, `db:apply` and the
# `db:generate`/`db:migrate`/`db:validate` scripts fail without it
# (bare `npx prisma` never reads this file).
# DATABASE_URL=file:./dev.db
# Turso Cloud: uncomment both lines.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=eyJhbGciOi...
# Docker only (the container path; it does not exist on your machine):
# DATABASE_URL=file:/data/printninja.db

# Origins allowed to call the API (exact match, comma-separated, no wildcard).
# Production desktop app: tauri://localhost. Dev app: http://localhost:1420.
# Trim to tauri://localhost (plus http://tauri.localhost for Android) on a
# production host; a missing origin makes the browser block the response.
CORS_ORIGINS="http://localhost:1420, tauri://localhost, http://tauri.localhost"

# Host port published for the API by docker compose. Default: 3001.
SERVER_PORT=3001

# Listen address and port of the service itself (compose fixes these
# inside the container). Defaults: 127.0.0.1 and 3001.
# HOST=127.0.0.1
# PORT=3001

# Reverse-proxy hops to trust for the client IP (0 = none).
# TRUST_PROXY=0

# Serve the OpenAPI browser UI and schema (off by default; compose
# turns it on; enable elsewhere only where you need to browse the API).
# DOCS_ENABLED=true
# LOG_LEVEL=info

# Sessions and sync retention.
# SESSION_TTL_DAYS=30
# SESSION_CLEANUP_MINUTES=60
# SYNC_TOMBSTONE_DAYS=90
# SYNC_PAGE_BYTES=8388608

# Rate limits.
# RATE_LIMIT_MAX=120
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_SECONDS=300

# Password hashing cost (argon2id).
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2
# ARGON2_PARALLELISM=1
