# PrintNinja local stack — usable defaults for `server/docker-compose.yml`.
# Copy to `.env` in this folder and go:
#   cp env.example .env && docker compose up -d --build
# Never commit `.env`. Every variable, explained: ../docs/ENV.md.

# PostgreSQL password for the bundled `db` container. Dev-only value below;
# generate a real one for anything shared: openssl rand -hex 24
# Use letters and digits only — it is interpolated into the default
# DATABASE_URL, so characters such as @ : / # % would break the URL.
# Unused when DATABASE_URL (below) points at your own PostgreSQL.
POSTGRES_PASSWORD=changeme01

# External PostgreSQL: uncomment and set to use your own database instead
# of the bundled `db` container, then start only the server:
#   docker compose up -d --build --no-deps server
# The database must exist and be reachable from inside the container
# (`localhost` there means the container itself — use a LAN IP,
# host.docker.internal on Docker Desktop, or a shared Docker network).
# URL-encode special characters in the password (@ → %40, : → %3A,
# / → %2F, # → %23, % → %25). The role needs DDL rights: the image runs
# `prisma migrate deploy` on boot.
# DATABASE_URL=postgresql://printninja:changeme01@db.example.com:5432/printninja

# Origins allowed to call the API (exact match, comma-separated, no wildcard).
# Production desktop app: tauri://localhost. Dev app: http://localhost:1420.
# Trim to tauri://localhost (plus http://tauri.localhost for Android) on a
# production host; a missing origin makes the browser block the response.
CORS_ORIGINS="http://localhost:1420, tauri://localhost, http://tauri.localhost"

# Host port published for the API. Default: 3001.
SERVER_PORT=3001

# Serve the OpenAPI browser UI and schema (off by default; enable only
# on hosts where you need to browse the API).
# DOCS_ENABLED=true
